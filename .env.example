# URL publique du site (sert aux liens de parrainage et aux retours Stripe)
PUBLIC_URL=https://biocez.fr
PORT=3000
NODE_ENV=production

# Base SQLite
DATABASE_PATH=data/biocez.db

# Stripe (sans clé : paiements simulés sur /paiement-test, hors production)
STRIPE_SECRET_KEY=sk_live_...
# Webhook à déclarer sur https://biocez.fr/api/stripe/webhook
# Événements : checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_...

# Jeton de la page /admin (long et aléatoire)
ADMIN_TOKEN=

# E-mails (Brevo, https://app.brevo.com > SMTP & API > Clés API).
# Sans clé : les e-mails sont affichés dans la console du serveur au lieu d'être envoyés.
BREVO_API_KEY=
# Expéditeur : adresse à valider dans Brevo (Expéditeurs & domaines), avec le domaine authentifié (SPF/DKIM)
MAIL_FROM=Biocez <contact@biocez.fr>

# Connexion / inscription « Continuer avec Google » (facultatif ; sans valeur, le bouton n'apparaît pas).
# Google Cloud Console > API et services > Identifiants > ID client OAuth (application Web),
# origines JavaScript autorisées : https://biocez.fr
GOOGLE_CLIENT_ID=

# URL publique du site (sert aux liens de parrainage et aux retours Stripe)
PUBLIC_URL=https://biocez.com
PORT=3000
NODE_ENV=production

# Base SQLite
DATABASE_PATH=data/biocez.db

# Stripe (sans clé : paiements simulés sur /paiement-test, hors production)
STRIPE_SECRET_KEY=sk_live_...
# Webhook à déclarer sur https://biocez.com/api/stripe/webhook
# Événements : checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_...

# Jeton de la page /admin (long et aléatoire)
ADMIN_TOKEN=
